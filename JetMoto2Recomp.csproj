<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>JetMoto2Recomp</AssemblyName>
        <RootNamespace>JetMoto2</RootNamespace>
        <TieredPGO>true</TieredPGO>
        <ServerGarbageCollector>false</ServerGarbageCollector>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <NoWarn>$(NoWarn);CS0164;CS0162;CS0168;CS0219;CS8981</NoWarn>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.cs"/>
        <Compile Include="generated\**\*.cs"/>
        <Compile Include="patches\**\*.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="RecompOne\RecompOne.Runtime\RecompOne.Runtime.csproj"/>
    </ItemGroup>

</Project>
